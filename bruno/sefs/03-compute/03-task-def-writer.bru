meta {
  name: R2 — DescribeTaskDefinition (writer)
  type: http
  seq: 3
}

post {
  url: https://ecs.{{awsRegion}}.amazonaws.com/
  body: json
  auth: awsv4
}

headers {
  Content-Type: application/x-amz-json-1.1
  X-Amz-Target: AmazonEC2ContainerServiceV20141113.DescribeTaskDefinition
}

auth:awsv4 {
  accessKeyId: 
  secretAccessKey: 
  sessionToken: 
  service: ecs
  region: {{awsRegion}}
  profileName: {{awsProfile}}
}

body:json {
  {
    "taskDefinition": "{{writer_task_definition}}"
  }
}

tests {
  test("HTTP 200", function(){ expect(res.getStatus()).to.equal(200); });

  const td = res.getBody().taskDefinition;
  const vol = td.volumes[0].efsVolumeConfiguration;
  const mp = td.containerDefinitions[0].mountPoints[0];
  test("volume is the shared EFS via the writer access point, TLS + IAM authorization on", function(){
    expect(vol.fileSystemId).to.equal(bru.getVar("file_system_id"));
    expect(vol.transitEncryption).to.equal("ENABLED");
    expect(vol.authorizationConfig.iam).to.equal("ENABLED");
    expect(vol.authorizationConfig.accessPointId).to.equal(bru.getVar("writer_access_point_id"));
  });
  test("R2: container mount readOnly=false", function(){ expect(mp.readOnly).to.equal(false); });

  test("writer and reader run as different roles", function(){
    expect(td.taskRoleArn).to.not.equal(bru.getVar("reader_role_arn_from_policy"));
  });
}
