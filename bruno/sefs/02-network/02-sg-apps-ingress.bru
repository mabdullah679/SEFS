meta {
  name: R8 — sg-apps: no ingress at all
  type: http
  seq: 2
}

get {
  url: https://ec2.{{awsRegion}}.amazonaws.com/?Action=DescribeSecurityGroupRules&Version=2016-11-15&Filter.1.Name=group-id&Filter.1.Value.1={{apps_security_group_id}}
  body: none
  auth: awsv4
}

auth:awsv4 {
  accessKeyId: 
  secretAccessKey: 
  sessionToken: 
  service: ec2
  region: {{awsRegion}}
  profileName: {{awsProfile}}
}

tests {
  test("HTTP 200", function(){ expect(res.getStatus()).to.equal(200); });

  const xml = String(res.getBody()).replace(/<tagSet>[\s\S]*?<\/tagSet>/g, ""); // tags nest <item>s that would end the rule <item> early
  const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].map(m => m[1]);
  const tag = (s, t) => { const parts = s.split("<" + t + ">"); return parts.length > 1 ? parts[1].split("<")[0] : null; };
  const rules = items.filter(i => tag(i, "securityGroupRuleId")).map(i => ({
    egress: tag(i, "isEgress") === "true", from: tag(i, "fromPort"), to: tag(i, "toPort"), proto: tag(i, "ipProtocol"),
    cidr: tag(i, "cidrIpv4"), cidr6: tag(i, "cidrIpv6"), ref: (/<referencedGroupInfo>[\s\S]*?<groupId>([^<]+)<\/groupId>/.exec(i) || [])[1] || null
  }));

  test("the group exists (it has at least one rule; a bogus ID returns an empty set)", function(){ expect(rules.length).to.be.at.least(1); });
  test("R8: sg-apps has zero ingress rules", function(){ expect(rules.filter(r => !r.egress)).to.have.lengthOf(0); });
}
