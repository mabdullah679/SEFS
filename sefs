#!/usr/bin/env bash
# sefs: the one command for this project. Wraps setup.sh and the Makefile, and reads live facts
# about the deployed stack by keyword from the SSM registry (/<name>/outputs/*) that Terraform
# publishes. Deterministic: same inputs, same calls; nothing here mutates AWS except the
# targets that say so (setup, up, apply, down). bash 3.2 compatible (macOS default).
set -euo pipefail
cd "$(dirname "$0")"

# ---------- configuration (read, never hardcoded beyond the project's defaults)
tfvar() { sed -nE "s/^$1 *= *\"([^\"]+)\".*/\1/p" account.auto.tfvars 2>/dev/null | head -1; }
NAME="${SEFS_NAME:-$(tfvar name)}"; NAME="${NAME:-sefs}"
REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-$(tfvar region)}}"; REGION="${REGION:-ap-southeast-2}"
export AWS_REGION="$REGION" AWS_PAGER=""
# A stalled API call must fail fast, not hang the screen: observed 2026-10-26, one EFS DescribeFileSystems
# sat >3 min on the default 60 s read timeout x retries while the same call from a new process answered in 1 s.
aws() { command aws --cli-connect-timeout 5 --cli-read-timeout 20 "$@"; }

usage() {
  cat <<EOF
sefs - one command for the whole project (region $REGION, project '$NAME')

First time on a machine:
  ./sefs setup                 run this single command and enter inputs where requested
                               (AWS account confirm, region, alarm e-mail, GitHub repo, secrets); it deploys at the end

Deploy / test (wrap the Makefile; same names):
  ./sefs up | plan | apply CHILD=<child> | verify | e2e | bruno | cost | test | preflight
  ./sefs down                  destroy everything incl. the data (asks CONFIRM_DESTROY_DATA=yes)

Read the live stack (read-only; works with any AWS login that can read SSM/ECS/EFS/CloudWatch):
  ./sefs show [keyword]        deployed IDs from the SSM registry, filtered by keyword (efs, subnet, cluster, log, backup, ...)
  ./sefs status                services, EFS, alarms in one screen
  ./sefs logs writer|reader [N] last N lines (default 20) of the app's newest log stream
  ./sefs alarms                every alarm and its state
  ./sefs url                   console links (dashboard, cluster, file system)
EOF
}

# ---------- helpers
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing tool: $1" >&2; exit 1; }; }
die() { echo "$*" >&2; exit 1; }
registry() { # prints "key<TAB>value" for every /<name>/outputs/* parameter, sorted
  aws ssm get-parameters-by-path --path "/$NAME/outputs" --recursive \
    --query 'Parameters[].[Name,Value]' --output text 2>/dev/null | sed "s|^/$NAME/outputs/||" | sort
}
reg() { registry | awk -F'\t' -v k="$1" '$1==k{print $2}'; }
deployed_or_die() {
  [ -n "$(registry)" ] || die "nothing deployed in $REGION for project '$NAME' (no /$NAME/outputs/* in SSM). Run ./sefs setup or ./sefs up."
}

# ---------- read-only commands
cmd_show() {
  need aws; deployed_or_die
  local kw="${1:-}" pat rows
  # keyword -> key pattern (synonyms first, then the word itself); values are searched only if no key matches
  case "$(printf '%s' "$kw" | tr '[:upper:]' '[:lower:]')" in
    efs|fs|filesystem|storage) pat='file_system|access_point|efs_' ;;
    sg|security)               pat='security_group' ;;
    log|logs)                  pat='log_group' ;;
    net|network|vpc|subnet)    pat='vpc|subnet' ;;
    ecs|service|cluster|app)   pat='cluster|service' ;;
    alarm|alert|dash|obs)      pat='alerts|dashboard' ;;
    *)                         pat="$kw" ;;
  esac
  rows=$(registry | { [ -n "$kw" ] && awk -F'\t' -v p="$pat" 'tolower($1) ~ p' || cat; })
  [ -n "$rows" ] || rows=$(registry | grep -i -- "$kw" || true)
  [ -n "$rows" ] || die "no deployed value matches '$kw'. Keys: $(registry | cut -f1 | tr '\n' ' ')"
  printf '%s\n' "$rows" | awk -F'\t' '{printf "%-24s %s\n", $1, $2}'
}

cmd_status() {
  need aws; deployed_or_die
  local cluster fs
  cluster=$(reg cluster_name); fs=$(reg file_system_id)
  echo "project=$NAME region=$REGION account=$(aws sts get-caller-identity --query Account --output text)"
  echo "--- services ($cluster)"
  aws ecs describe-services --cluster "$cluster" --services "$(reg writer_service_name)" "$(reg reader_service_name)" \
    --query 'services[].[serviceName,status,runningCount,desiredCount,deployments[0].rolloutState]' --output text \
    | awk '{printf "%-16s %-8s running=%s desired=%s rollout=%s\n", $1, $2, $3, $4, $5}'
  echo "--- file system ($fs)"
  aws efs describe-file-systems --file-system-id "$fs" \
    --query 'FileSystems[0].[LifeCycleState,Encrypted,PerformanceMode,ThroughputMode,NumberOfMountTargets,SizeInBytes.Value]' --output text \
    | awk '{printf "state=%s encrypted=%s perf=%s throughput=%s mount_targets=%s bytes=%s\n", $1, $2, $3, $4, $5, $6}'
  echo "--- alarms"
  cmd_alarms
}

cmd_alarms() {
  need aws; deployed_or_die
  aws cloudwatch describe-alarms --alarm-name-prefix "$NAME" --query 'MetricAlarms[].[StateValue,AlarmName]' --output text \
    | sort | awk '{printf "%-18s %s\n", $1, $2}'
}

cmd_logs() {
  need aws; deployed_or_die
  local app="${1:-}" n="${2:-20}" group stream
  case "$app" in writer|reader) ;; *) die "usage: ./sefs logs writer|reader [N]";; esac
  group=$(reg "${app}_log_group")
  stream=$(aws logs describe-log-streams --log-group-name "$group" --order-by LastEventTime --descending --max-items 1 \
    --query 'logStreams[0].logStreamName' --output text | head -1)
  [ -n "$stream" ] && [ "$stream" != "None" ] || die "no log stream yet in $group"
  echo "# $group / $stream (last $n)"
  aws logs get-log-events --log-group-name "$group" --log-stream-name "$stream" --limit "$n" --query 'events[].message' --output text | tr '\t' '\n'
}

cmd_url() {
  need aws; deployed_or_die
  local c="https://$REGION.console.aws.amazon.com"
  echo "dashboard:   $c/cloudwatch/home?region=$REGION#dashboards:name=$(reg dashboard_name)"
  echo "cluster:     $c/ecs/v2/clusters/$(reg cluster_name)/services?region=$REGION"
  echo "file system: $c/efs/home?region=$REGION#/file-systems/$(reg file_system_id)"
  echo "all tagged:  $c/resource-groups/tag-editor/find-resources?region=$REGION  (tag Project=$NAME)"
}

# ---------- dispatch
cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  setup)          need bash; exec ./setup.sh "$@" ;;
  up|plan|verify|e2e|bruno|cost|test|preflight|down|init|bootstrap|test-unit|test-mutation|test-contract|test-setup|tf-profile|bruno-profile)
                  need make; exec make "$cmd" "$@" ;;
  apply)          need make; exec make apply-one "$@" ;;
  show)           cmd_show "$@" ;;
  status)         cmd_status ;;
  alarms)         cmd_alarms ;;
  logs)           cmd_logs "$@" ;;
  url)            cmd_url ;;
  *)              usage >&2; die "unknown command: $cmd" ;;
esac
